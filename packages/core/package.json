{
  "name": "@chainza/safenet-staking-core",
  "version": "0.1.0",
  "description": "Headless TypeScript library for SAFE staking contract interaction (viem only).",
  "license": "MIT",
  "keywords": [
    "safe",
    "safenet",
    "staking",
    "ethereum",
    "viem",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chainza/safenet-staking-monorepo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Chainza/safenet-staking-monorepo/tree/main/packages/core#readme",
  "bugs": "https://github.com/Chainza/safenet-staking-monorepo/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "viem": "2.51.3",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "ts-essentials": "10.2.1"
  }
}
