{
  "name": "@chainza/safenet-staking-widget",
  "version": "0.2.0",
  "description": "Drop-in React widget for SAFE staking, built on @chainza/safenet-staking-core.",
  "license": "MIT",
  "keywords": [
    "safe",
    "safenet",
    "staking",
    "ethereum",
    "react",
    "wagmi",
    "viem",
    "widget",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chainza/safenet-staking-monorepo.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/Chainza/safenet-staking-monorepo/tree/main/packages/widget#readme",
  "bugs": "https://github.com/Chainza/safenet-staking-monorepo/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:css": "postcss src/styles.css -o dist/styles.css",
    "dev": "tsup --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@safe-global/safe-apps-provider": "~0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": ">=5",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.0.0",
    "wagmi": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@safe-global/safe-apps-provider": {
      "optional": true
    },
    "@safe-global/safe-apps-sdk": {
      "optional": true
    },
    "@walletconnect/ethereum-provider": {
      "optional": true
    }
  },
  "dependencies": {
    "@chainza/safenet-staking-core": "workspace:*",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "tailwind-merge": "3.6.0",
    "ts-essentials": "10.2.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/react-query": "5.100.14",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.7",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "postcss-cli": "11.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "viem": "2.51.3",
    "vitest": "4.1.7",
    "wagmi": "3.6.16"
  }
}
